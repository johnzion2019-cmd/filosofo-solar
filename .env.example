# Copy to .env.local for local development. Leave Deye values empty to stay in Demo mode.

# Optional gate for the web UI and JSON APIs. The ingest webhook uses its own key.
APP_PIN=

# SQLite file. On Render this should live on the persistent disk.
DATABASE_PATH=./data/filosofo.sqlite

# Encrypts Deye secrets and the ingest key at rest. Generated automatically if omitted.
SETTINGS_SECRET=

# eu | us | india | custom
DEYE_REGION=eu
DEYE_BASE_URL=
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
DEYE_COMPANY_ID=
DEYE_STATION_ID=
DEYE_DEVICE_SN=2508073177

# How often the server asks Deye Cloud for a new reading.
POLL_INTERVAL_SEC=60

# auto | demo | deye | bridge
DATA_SOURCE=auto

# Bearer token for POST /api/ingest. Generated and shown in Settings if omitted.
INGEST_API_KEY=
